DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/sonprj
SECA_DB_SSLMODE=prefer
SECA_ACCESS_TOKEN_EXPIRE_MINUTES=720
SECA_PBKDF2_ITERATIONS=600000
SECA_URL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
SECA_GATEWAY_INGEST_TOKEN=
SECA_PROXY_AUTOSTART=false
SECA_PROXY_LISTEN_HOST=0.0.0.0
SECA_PROXY_LISTEN_PORT=3128
SECA_PROXY_BLOCKLIST_REFRESH_SECONDS=10
SECA_PROXY_ACTIVE_WINDOW_SECONDS=60
SECA_PROXY_TUNNEL_CHUNK_BYTES=262144
SECA_PROXY_ACTIVITY_TOUCH_SECONDS=1.0
SECA_GATEWAY_AUDIT_ASYNC=true
SECA_GATEWAY_AUDIT_FLUSH_SECONDS=0.5
SECA_GATEWAY_AUDIT_BATCH_SIZE=200
SECA_OTP_EXPIRE_MINUTES=10
SECA_OTP_RESEND_COOLDOWN_SECONDS=60
SECA_OTP_MAX_REQUESTS_PER_HOUR=5
SECA_OTP_SECRET=
SECA_SMTP_HOST=
SECA_SMTP_PORT=587
SECA_SMTP_USERNAME=
SECA_SMTP_PASSWORD=
SECA_SMTP_FROM_EMAIL=
SECA_SMTP_FROM_NAME=SECA Security
SECA_SMTP_USE_TLS=true
SECA_SMTP_USE_SSL=false
SECA_SMTP_ALLOW_DEV_FALLBACK=true

